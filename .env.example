### LikeC4 Diagram API configuration
###
### Copy this file to `.env` and adjust values as needed.
### Settings use the LIKEC4_API_ prefix (see app/core/config.py).

# Basic app settings
LIKEC4_API_APP_NAME="LikeC4 Diagram API"
LIKEC4_API_DEBUG=false

# --- AI generation (optional) ---
# Enable the AI endpoint for generating LikeC4 DSL from natural language.
# Requires the optional [ai] dependency.
#
# LIKEC4_API_AI_ENABLED=true
# LIKEC4_API_OPENAI_API_KEY="sk-1234"
# LIKEC4_API_OPENAI_BASE_URL="https://api.openai.com/v1"
# LIKEC4_API_LITELLM_BASE_URL="https://litellm.example.com/v1"
# LIKEC4_API_AI_MODEL="openai/gpt-4o"

# --- Turso / libSQL database (optional) ---
# Enable Turso integration using pyturso. When enabled, the app will create a
# process-wide connection on startup and close it on shutdown.
#
# Local database path (or :memory: for in-memory)
# LIKEC4_API_TURSO_ENABLED=true
# LIKEC4_API_TURSO_DB_PATH="local.db"
#
# Remote Turso URL and auth token (embedded replica sync).
# You can also set LIBSQL_URL / LIBSQL_AUTH_TOKEN instead.
# LIKEC4_API_TURSO_REMOTE_URL="https://<db>.<region>.turso.io"
# LIKEC4_API_TURSO_AUTH_TOKEN="your-token-here"

